{
  "appId": "com.github.michaelolivier96.wealthviewer",
  "productName": "WealthViewer",
  "directories": {
    "buildResources": "resources"
  },
  "files": [
    "assets/**/*",
    "build/**/*",
    "capacitor.config.*",
    "app/**/*"
  ],
  "publish": {
    "provider": "github",
    "owner": "MichaelOlivier96",
    "repo": "WealthViewer",
    "releaseType": "release"
  },
  "nsis": {
    "allowElevation": true,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "win": {
    "target": "nsis",
    "icon": "assets/appIcon.ico"
  },
  "mac": {
    "category": "public.app-category.finance",
    "target": "dmg"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "maintainer": "MichaelOlivier96 <MichaelOlivier96@users.noreply.github.com>",
    "icon": "assets/appIcon.png",
    "category": "Finance"
  }
}